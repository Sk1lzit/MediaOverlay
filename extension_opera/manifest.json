{
  "manifest_version": 3,
  "name": "MediaOverlay Bridge",
  "version": "1.0.0",
  "description": "Связь Opera GX с MediaOverlay: громкость вкладок, медиа-данные",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "MediaOverlay Bridge"
  }
}